{
  "$schema": "node_modules/wrangler/config-schema.json",
  // vinext 組み込みの App Router エントリ。
  "main": "vinext/server/app-router-entry",
  "name": "wiki-frontend",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "vars": {
    "CLIENT_ID": "019fe59c-1673-72f5-a5d2-49cce1d4161f",
  },
  // 編集中の画像の一時置き場。エディタが AVIF を `pending/<postUuid>/<imageId>.avif`
  // に PUT し、記事の保存時に本文と同じコミットへ移して削除する。保存されずに
  // 残ったものは `pending/` に付けたライフサイクルルール (7 日) が掃除する。
  "r2_buckets": [
    {
      "binding": "PENDING_IMAGES",
      "bucket_name": "wiki-frontend-pending-images",
    },
  ],
  // secrets は Cloudflare Secrets Store (BSM: morinoparty プロジェクト) から供給する。
  // 他の env と違いバインディング経由の非同期 `.get()` で読む (src/lib/secrets.ts)。
  "secrets_store_secrets": [
    {
      "binding": "AUTH_SECRET",
      "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
      "secret_name": "shared_AUTH_SECRET",
    },
    {
      "binding": "MAIN_SERVER_URL",
      "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
      "secret_name": "shared_MAIN_SERVER_URL",
    },
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "d36d5a11ea07462c83bb21a0e9ccb811",
      "secret_name": "wiki_frontend_GITHUB_TOKEN",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
