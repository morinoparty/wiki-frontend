{
  "name": "wiki-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "prepare": "panda codegen",
    "generate": "pnpm run generate:license && pnpm run generate:index",
    "generate:license": "license-checker-rseidelsohn --json --out \"./src/generated/license.json\"",
    "generate:index": "tsx src/generate-search-index.ts",
    "dev": "pnpm run generate && cf dev",
    "build": "pnpm run generate && cf build",
    "deploy": "pnpm run generate && cf build && cf deploy --prebuilt --mode production",
    "typecheck": "cf workers types && tsc --noEmit"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@mdxeditor/editor": "^4.3.3",
    "@mdxeditor/gurx": "^1.2.4",
    "@morinoparty/chlorophyll-react": "0.4.10",
    "@morinoparty/hagaki": "^0.3.0",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "^1.7.11",
    "flexsearch": "^0.8.212",
    "lexical": "^0.48.0",
    "lucide-react": "^1.59.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.2",
    "@pandacss/dev": "^1.12.1",
    "@pandacss/preset-base": "^1.12.1",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.20",
    "license-checker-rseidelsohn": "^5.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
