# AUTH_SECRET is the Better Auth signing secret. It is stored in Bitwarden
# Secrets Manager (project: morinoparty) and in Cloudflare Secrets Store for the
# deployed Worker.
# BETTER_AUTH_URL is intentionally NOT set: src/lib/auth.ts derives baseURL from
# the incoming request origin so preview/production/local all work unchanged.
AUTH_SECRET= # BSM: shared/AUTH_SECRET / CF Secrets Store: shared_AUTH_SECRET
MAIN_SERVER_URL=https://api.morino.party/main
SERVER_URL=https://api.morino.party/
SERVERS=main,res,lobby
CLIENT_ID=019fe59c-1673-72f5-a5d2-49cce1d4161f
