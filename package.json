{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "panda codegen",
    "dev": "pnpm generate:license && next dev --turbopack",
    "build": "pnpm generate:license && pnpm index && next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm index && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "index": "pnpm dlx tsx src/generate-search-index.ts",
    "generate:license": "pnpm dlx license-checker-rseidelsohn --json --out './src/app/(normal)/license/data.json'"
  },
  "dependencies": {
    "@ark-ui/react": "5.37.0",
    "@mdxeditor/editor": "^3.32.3",
    "@mdxeditor/gurx": "^1.2.3",
    "@morinoparty/chlorophyll-react": "file:../chlorophyll/packages/react",
    "@opennextjs/cloudflare": "^1.0.2",
    "better-auth": "^1.6.26",
    "flexsearch": "^0.8.167",
    "gray-matter": "^4.0.3",
    "hagaki": "file:../hagaki",
    "lucide-react": "^0.511.0",
    "next": "15.3.2",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.5.0",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@pandacss/dev": "^1.7.2",
    "@pandacss/preset-base": "^1.7.2",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "typescript": "^5",
    "wrangler": "^4.15.2"
  }
}
